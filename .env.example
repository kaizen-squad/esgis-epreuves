# Copier ce fichier vers .env.local et renseigner les valeurs (jamais commiter .env.local).

# Supabase : projet "dev" en local, projet de prod sur Vercel.
# Visibles du navigateur, sans risque.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Serveur uniquement (scripts de seed, actions serveur). Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Cloudflare R2 (stockage des PDF), serveur uniquement.
# En local : bucket esgis-epreuves-dev. La clé prod ne va que dans les variables Vercel de production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
